# ---------- Core (required) ----------
# SQLite database file. To use Postgres instead, change provider in prisma/schema.prisma and set a postgres:// URL.
DATABASE_URL="file:../data/mailbridge.db"
# Long random string used to sign login sessions:   openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Long random string used to encrypt mailbox passwords & API keys:   openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-another-long-random-string"
# Public URL of this app (used to show the WhatsApp webhook URL)
APP_URL="http://localhost:3000"

# ---------- Optional fallbacks ----------
# Everything below can be managed from the dashboard (AI Keys / Settings pages).
# Values saved in the dashboard override these.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_APP_SECRET=""
WA_VERIFY_TOKEN=""
OWNER_WHATSAPP_NUMBER=""
WA_TEMPLATE_NAME="new_email_alert"
WA_TEMPLATE_LANG="en"
