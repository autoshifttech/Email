# ---------- Core (required) ----------
# PostgreSQL database.
# Supabase: Project Settings → Database → Connection string
#   DATABASE_URL = "Transaction pooler" URI (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" or direct URI (port 5432), used for migrations
# Local / Docker: use the same URL for both.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailbridge"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mailbridge"
# Long random string used to sign login sessions:   openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Long random string used to encrypt mailbox passwords & API keys:   openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-another-long-random-string"
# Public URL of this app (used to show the WhatsApp webhook + sync URLs)
APP_URL="http://localhost:3000"

# Optional: secret for /api/cron/sync. If empty, one is generated and shown in Settings.
CRON_SECRET=""

# ---------- Optional fallbacks ----------
# Everything below can be managed from the dashboard (AI Keys / Settings pages).
# Values saved in the dashboard override these.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_APP_SECRET=""
WA_VERIFY_TOKEN=""
OWNER_WHATSAPP_NUMBER=""
WA_TEMPLATE_NAME="new_email_alert"
WA_TEMPLATE_LANG="en"
