{
  "name": "mailbridge",
  "version": "1.0.0",
  "private": true,
  "description": "MailBridge - AI email assistant: inbox summaries on WhatsApp, AI-drafted replies with approval, and a PWA dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "dev:all": "concurrently -n web,worker -c blue,green \"npm:dev\" \"npm:worker\"",
    "start:all": "concurrently -n web,worker -c blue,green \"npm:start\" \"npm:worker\"",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test:e2e": "tsx tests/e2e/run.ts",
    "vercel-build": "prisma generate && sh -c 'DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma migrate deploy' && next build",
    "db:migrate": "prisma migrate deploy"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/smtp-server": "^3.5.12",
    "smtp-server": "^3.14.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "imapflow": "^1.0.196",
    "jose": "^6.1.0",
    "mailparser": "^3.14.2",
    "next": "^15.5.29",
    "nodemailer": "^10.4.0",
    "openai": "^5.23.0",
    "prisma": "^6.16.2",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  }
}
